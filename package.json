{
  "name": "pi-desktop-ui",
  "version": "2.0.0",
  "description": "A local desktop app for the pi coding agent: chat, sessions, diffs and usage analytics in an Electron window, or in the browser.",
  "license": "MIT",
  "author": "Rumi-sketches <rumi.sketches@outlook.com>",
  "type": "module",
  "private": true,
  "main": "server.mjs",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "pi",
    "coding-agent",
    "desktop",
    "electron",
    "web-ui",
    "llm"
  ],
  "scripts": {
    "start": "node bin/pi-desktop-ui.mjs",
    "app": "electron electron/main.mjs",
    "shortcut": "node scripts/create-shortcut.mjs",
    "lint": "eslint .",
    "verify": "node scripts/verify.mjs",
    "test": "node --test \"test/*.test.mjs\" && npm run verify"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@highlightjs/cdn-assets": "^11.12.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.13",
    "marked": "^18.0.9",
    "node-pty": "1.1.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "electron": "^43.3.0",
    "eslint": "^9.39.5",
    "typescript": "^7.0.2"
  }
}
